PORT=3000

# Together (clave de plataforma)
TOGETHER=
MODEL_VISION1=moonshotai/Kimi-K2.6
MODEL_VISION_FALLBACK=google/gemma-4-31B-it
MODEL_AGENT_PLANNER=openai/gpt-oss-20b
MODEL_AGENT_PLANNER_FALLBACK=Qwen/Qwen3.5-9B
MODEL_AGENT_RESPONSE=openai/gpt-oss-120b
MODEL_AGENT_RESPONSE_FALLBACK=Qwen/Qwen3.5-9B
TOGETHER_TIMEOUT_MS=60000

# Autenticación HMAC entre servicios. Debe coincidir con AI_SERVICE_KEY/SECRET de guaba-api.
GUABA_SERVICE_KEY=guaba-api
GUABA_SERVICE_SECRET=

# Administración futura y cifrado de credenciales BYOK.
AI_ADMIN_KEY=
# 32 bytes en Base64 o 64 caracteres hex. No debe cambiarse sin un proceso de rotación.
AI_CREDENTIALS_MASTER_KEY=

# Compatibilidad temporal; desactivar después de migrar todos los consumidores a HMAC.
ALLOW_LEGACY_BASIC_AUTH=true
AUTH_USERNAME=
AUTH_PASSWORD=

# Operación
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=90
MAX_IMAGE_BYTES=8388608
JSON_BODY_LIMIT=10mb

# MySQL de este servicio
MYSQLHOST=
MYSQLPORT=3306
MYSQL_DATABASE=
MYSQLUSER=
MYSQLPASSWORD=
